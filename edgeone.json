{
  "name": "gifted-brains-eduspace",
  "installCommand": "npm install",
  "buildCommand": "node scripts/verify-edgeone.mjs",
  "outputDirectory": "public",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60
    }
  }
}
